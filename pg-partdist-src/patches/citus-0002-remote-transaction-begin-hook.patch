@@ -83,6 +83,12 @@ static char *IsolationLevelName[] = {
 /* The MultiConnection used for connecting Citus main database. */
 MultiConnection *MainDBConnection = NULL;
 
+/*
+ * ShardPG：开远程事务分支时，扩展可往同一条 BEGIN 消息里追加自己的交接语句
+ * （紧跟在 assign_distributed_transaction_id 之后）。为空时行为与原版相同。
+ */
+PGDLLEXPORT remote_transaction_begin_hook_type remote_transaction_begin_hook = NULL;
+
 /*
  * IsMainDBCommand is true if this is a query in the Citus main database that is started
  * by a query from a different database.
@@ -422,6 +428,12 @@ AssignDistributedTransactionIdCommand(void)
 					 distributedTransactionId->transactionNumber,
 					 timestamp);
 
+	/* ShardPG：扩展随同一条消息交代自己的事务上下文（如全局事务号与快照时间戳） */
+	if (remote_transaction_begin_hook != NULL)
+	{
+		remote_transaction_begin_hook(assignDistributedTransactionId);
+	}
+
 	/* free the StringInfo but not the buffer itself */
 	char *command = assignDistributedTransactionId->data;
 	pfree(assignDistributedTransactionId);

@@ -377,6 +378,26 @@ tuple_lock_retry:
 	result = heap_lock_tuple(relation, tuple, cid, mode, wait_policy,
 							 follow_updates, &buffer, tmfd);
 
+	/*
+	 * patch 0011: shard-managed relations provide snapshot isolation without

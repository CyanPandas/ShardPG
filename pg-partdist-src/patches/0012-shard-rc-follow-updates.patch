diff -ruN a/src/include/access/shard_stamp.h b/src/include/access/shard_stamp.h
--- a/src/include/access/shard_stamp.h	2026-10-14 21:11:02.101802189 +0000
+++ b/src/include/access/shard_stamp.h	2026-10-14 21:11:28.999578848 +0000

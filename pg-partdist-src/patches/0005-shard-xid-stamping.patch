 #include "utils/snapmgr.h"
 #include "utils/spccache.h"
 #include "utils/syscache.h"
+#include "access/shard_stamp.h"
+
+/* pg_partdist patch 0005: shard-managed relations stamp tuples with the
+ * extension-supplied per-shard xid instead of the native xid.  The record
+ * header xid stays native; redo re-derives the shard xid from the record
+ * body (see shard_stamp.h). */
+shard_relation_xid_hook_type shard_relation_xid_hook = NULL;
+
+static inline TransactionId
+shard_stamp_xid(Relation relation, TransactionId xid, bool *is_shard)
+{
+	TransactionId sxid;
+
+	if (shard_relation_xid_hook &&
+		shard_relation_xid_hook(relation, true, &sxid))
+	{
+		if (is_shard)
+			*is_shard = true;
+		return sxid;
+	}
+	if (is_shard)
+		*is_shard = false;
+	return xid;
+}
+
+static inline bool
+shard_relation_p(Relation relation)
+{
+	return shard_relation_xid_hook &&
+		shard_relation_xid_hook(relation, false, NULL);
+}
+
+static inline TransactionId
+shard_xid_from_maindata(XLogReaderState *record)
+{
+	Size		len = XLogRecGetDataLen(record);
+	TransactionId sxid;
+
+	memcpy(&sxid, XLogRecGetData(record) + len - sizeof(TransactionId),
+		   sizeof(TransactionId));
+	return sxid;
+}
 
 

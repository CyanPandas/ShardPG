 /*
+ * patch 0013: XLogWriteUpTo -- like XLogFlush(record), but only write() the
+ * WAL up to 'record' into the kernel, no fsync.  For callers that need the
+ * bytes readable from the pg_wal files (e.g. reading back peer backends'
+ * records) without paying for durability; the commit record's own
+ * XLogFlush still provides that.  Piggybacks on any concurrent write/flush.
+ */
+void
+XLogWriteUpTo(XLogRecPtr record)
+{
+	XLogwrtRqst WriteRqst;
+	TimeLineID	insertTLI = XLogCtl->InsertTimeLineID;
+
+	if (!XLogInsertAllowed())
+		return;
+	if (record <= LogwrtResult.Write)
+		return;
+
+	START_CRIT_SECTION();
+	for (;;)
+	{
+		XLogRecPtr	insertpos;
+
+		SpinLockAcquire(&XLogCtl->info_lck);
+		LogwrtResult = XLogCtl->LogwrtResult;
+		SpinLockRelease(&XLogCtl->info_lck);
+		if (record <= LogwrtResult.Write)
+			break;
+
+		insertpos = WaitXLogInsertionsToFinish(record);
+
+		if (!LWLockAcquireOrWait(WALWriteLock, LW_EXCLUSIVE))
+			continue;			/* someone else wrote; recheck */
+
+		LogwrtResult = XLogCtl->LogwrtResult;
+		if (record <= LogwrtResult.Write)
+		{
+			LWLockRelease(WALWriteLock);
+			break;
+		}
+		WriteRqst.Write = insertpos;
+		WriteRqst.Flush = 0;	/* write only */
+		XLogWrite(WriteRqst, insertTLI, false);
+		LWLockRelease(WALWriteLock);
+		break;
+	}
+	END_CRIT_SECTION();
+}
+

 #include "libpq-fe.h"
 #include "miscadmin.h"
 #include "pg_config.h"
@@ -47,6 +49,76 @@
 
 int NodeConnectionTimeout = 30000;
 int MaxCachedConnectionsPerWorker = 1;
+
+/*
+ * ShardPG TPC-C: also cache connections opened from backends that serve an
+ * internal Citus connection. With function call delegation the transaction
+ * function runs inside such a backend on the worker; without caching, every
+ * cross-worker access opens (and the remote side forks) a new connection.
+ */
+bool CacheConnectionsInInternalBackends = false;
+
+/*
+ * ShardPG TPC-C: after a remote error aborts the transaction, a connection whose
+ * remote side is merely left in (failed) transaction state is still healthy --
+ * roll it back synchronously and keep it, instead of closing it and making the
+ * next transaction reconnect (and the worker fork a new backend). Snapshot-
+ * isolation conflicts make this the common case under contention.
+ */
+bool KeepConnectionsAfterAbort = false;
+
+static void
+TryRecoverConnectionForCaching(MultiConnection *connection)
+{
+	PGTransactionStatusType st;
+	PGresult   *res;
+
+	if (!KeepConnectionsAfterAbort || connection->pgConn == NULL ||
+		PQstatus(connection->pgConn) != CONNECTION_OK ||
+		connection->forceCloseAtTransactionEnd)
+		return;
+
+	st = PQtransactionStatus(connection->pgConn);
+	if (st == PQTRANS_ACTIVE)
+	{
+		/*
+		 * The error result was consumed but ReadyForQuery may still be in flight.
+		 * Wait briefly (bounded, ~50 ms total) for the remaining protocol messages;
+		 * give up -- and let the connection be closed as before -- if the remote
+		 * is actually still running something.
+		 */
+		int			sock = PQsocket(connection->pgConn);
+		int			waits = 0;
+
+		for (;;)
+		{
+			if (!PQconsumeInput(connection->pgConn))
+				break;
+			if (PQisBusy(connection->pgConn))
+			{
+				struct pollfd pfd;
+
+				if (sock < 0 || ++waits > 10)
+					break;
+				pfd.fd = sock;
+				pfd.events = POLLIN;
+				pfd.revents = 0;
+				(void) poll(&pfd, 1, 5);
+				continue;
+			}
+			res = PQgetResult(connection->pgConn);
+			if (res == NULL)
+				break;
+			PQclear(res);
+		}
+		st = PQtransactionStatus(connection->pgConn);
+	}
+	if (st == PQTRANS_INERROR || st == PQTRANS_INTRANS)
+	{
+		res = PQexec(connection->pgConn, "ROLLBACK");
+		PQclear(res);
+	}
+}
 int MaxCachedConnectionLifetime = 10 * MS_PER_MINUTE;
 
 HTAB *ConnectionHash = NULL;

+/*
+ * ShardPG：\dt 分两张表输出（2026-10-19 起）。
+ *
+ *   List of relations —— 与原版同样的列；Citus 分布式表的 Type 显示为 distributed_table，
+ *                         参考表为 reference_table，\dt+ 的 Size 是各分片大小之和
+ *   List of shards    —— 匹配到的哈希分布表的全部分片：所属表、哈希范围、主、从（\dt+ 加每片行数、大小）
+ *
+ * 分片键、分片数、每片副本数、共置不在 \dt 里，放在 \d 的尾行（shardpgAddTableFooters）。
+ *
+ * 只在纯 \dt（只列表）且服务器装了 Citus 时生效；匹配结果里一张 Citus 表都没有时返回 false，
+ * 由调用方照原样输出 —— 连普通 PostgreSQL 或只看本地表时与原版一致。
+ *
+ * from / where 是 listTables 已经拼好的 FROM 与 WHERE 子句（含模式匹配），两张表共用，
+ * 保证表与分片的筛选条件完全相同。
+ *
+ * 主从来自 pg_partdist 的控制面登记（partdist.partition_map / node_map），切主后
+ * 再执行一次即反映新主；没装 pg_partdist 或分片没登记时，主退回 Citus 的放置节点。
+ */
+
+/*
+ * 节点名（P7-N107）：节点号 1 是 master，其余 worker<节点号-1>，与数据目录名一致；
+ * 与 pg_partdist 的 shardpg.node_name() 同一规则（这里内联，不依赖扩展版本）
+ */
+#define SHARDPG_NM_NAME "CASE WHEN nm.node_id = 1 THEN 'master' ELSE 'worker' || (nm.node_id - 1) END"
+#define SHARDPG_ND_ADDR "CASE WHEN nd.nodename IN ('localhost', '127.0.0.1') THEN '' ELSE nd.nodename END" \
+		" || ':' || nd.nodeport"
+#define SHARDPG_NM_LABEL SHARDPG_NM_NAME " || CASE WHEN nm.status <> 'active' THEN ' (down)' ELSE '' END"
+/* 没有主从登记的分片：Citus 放置节点按地址到 node_map 里找名字，找不到才显示地址 */
+#define SHARDPG_ND_LABEL \
+		"COALESCE((SELECT " SHARDPG_NM_NAME " FROM partdist.node_map nm" \
+		" WHERE nm.port = nd.nodeport AND (nm.hostname = nd.nodename" \
+		" OR (nm.hostname IN ('localhost', '127.0.0.1') AND nd.nodename IN ('localhost', '127.0.0.1'))) LIMIT 1)," \
+		" " SHARDPG_ND_ADDR ")"
+
+/*
+ * 服务器上有没有 Citus、有没有 pg_partdist 的控制面登记表。没有 Citus 返回 false。
+ */
+static bool
+shardpgDetect(bool *have_partdist)
+{
+	PGresult   *res;
+	bool		have_citus;
+
+	res = PSQLexec("SELECT pg_catalog.to_regclass('pg_catalog.pg_dist_shard') IS NOT NULL,\n"
+				   "       pg_catalog.to_regclass('partdist.partition_map') IS NOT NULL AND\n"
+				   "       pg_catalog.to_regclass('partdist.node_map') IS NOT NULL");
+	if (!res)
+		return false;
+	have_citus = (PQntuples(res) == 1 && strcmp(PQgetvalue(res, 0, 0), "t") == 0);
+	*have_partdist = have_citus && strcmp(PQgetvalue(res, 0, 1), "t") == 0;
+	PQclear(res);
+	return have_citus;
+}
+
+/*
+ * 拼分片 sid（SQL 表达式）的主、从两列：\dt 的 List of shards 与 \d+ 的 Shards 尾行共用。
+ */
+static void
+shardpgAppendPrimaryReplicas(PQExpBuffer q, bool have_partdist, const char *sid)
+{
+	if (have_partdist)
+		appendPQExpBuffer(q,
+						  "  COALESCE((SELECT " SHARDPG_NM_LABEL " FROM partdist.partition_map m JOIN partdist.node_map nm"
+						  " ON nm.node_id = m.primary_node WHERE m.partition_id = %s),\n"
+						  "           (SELECT " SHARDPG_ND_LABEL " FROM pg_catalog.pg_dist_placement pl JOIN pg_catalog.pg_dist_node nd"
+						  " ON nd.groupid = pl.groupid AND nd.noderole = 'primary' WHERE pl.shardid = %s"
+						  " ORDER BY nd.nodeport LIMIT 1)) AS \"Primary\",\n"
+						  "  (SELECT pg_catalog.string_agg(" SHARDPG_NM_LABEL ", ',' ORDER BY nm.node_id) FROM partdist.partition_map m"
+						  " JOIN partdist.node_map nm ON nm.node_id = ANY (m.secondary_nodes) WHERE m.partition_id = %s) AS \"Replicas\"",
+						  sid, sid, sid);
+	else
+		appendPQExpBuffer(q,
+						  "  (SELECT " SHARDPG_ND_ADDR " FROM pg_catalog.pg_dist_placement pl JOIN pg_catalog.pg_dist_node nd"
+						  " ON nd.groupid = pl.groupid AND nd.noderole = 'primary' WHERE pl.shardid = %s"
+						  " ORDER BY nd.nodeport LIMIT 1) AS \"Primary\",\n"
+						  "  NULL::pg_catalog.text AS \"Replicas\"",
+						  sid);
+}
+
+/*
+ * 返回 true 表示由本函数接管：*rel_res 是 List of relations，*shard_res 是 List of shards
+ * （没有哈希分布表时为 NULL）。返回 false 时调用方走原版。
+ */
+static bool
+shardpgListTables(const char *from, const char *where, bool verbose, bool showAm,
+				  PGresult **rel_res, PGresult **shard_res)
+{
+	PGresult   *res;
+	PQExpBufferData q;
+	bool		have_partdist;
+	bool		any_citus = false;
+	bool		any_hash = false;
+	int			i;
+
+	*rel_res = NULL;
+	*shard_res = NULL;
+	if (!shardpgDetect(&have_partdist))
+		return false;
+
+	/* ---- List of relations：原版的列，只改 Type、\dt+ 的 Size ---- */
+	initPQExpBuffer(&q);
+	if (verbose)
+		appendPQExpBufferStr(&q,
+							 "WITH sz AS MATERIALIZED (SELECT shard_id, size FROM pg_catalog.citus_shard_sizes())\n");
+	appendPQExpBuffer(&q,
+					  "SELECT n.nspname AS \"%s\", c.relname AS \"%s\",\n"
+					  "  CASE WHEN dp.partmethod IN ('h', 'r', 'a') THEN 'distributed_table'"
+					  " WHEN dp.partmethod = 'n' AND dp.repmodel = 't' THEN 'reference_table'"
+					  " ELSE CASE c.relkind"
+					  " WHEN " CppAsString2(RELKIND_RELATION) " THEN '%s'"
+					  " WHEN " CppAsString2(RELKIND_TOASTVALUE) " THEN '%s'"
+					  " WHEN " CppAsString2(RELKIND_PARTITIONED_TABLE) " THEN '%s'"
+					  " WHEN 's' THEN 'special'"
+					  " END END AS \"%s\",\n"
+					  "  pg_catalog.pg_get_userbyid(c.relowner) AS \"%s\"",
+					  gettext_noop("Schema"),
+					  gettext_noop("Name"),
+					  gettext_noop("table"),
+					  gettext_noop("TOAST table"),
+					  gettext_noop("partitioned table"),
+					  gettext_noop("Type"),
+					  gettext_noop("Owner"));
+	if (verbose)
+	{
+		appendPQExpBuffer(&q,
+						  ",\n  CASE c.relpersistence WHEN 'p' THEN '%s' WHEN 't' THEN '%s' WHEN 'u' THEN '%s' END AS \"%s\"",
+						  gettext_noop("permanent"),
+						  gettext_noop("temporary"),
+						  gettext_noop("unlogged"),
+						  gettext_noop("Persistence"));
+		if (showAm)
+			appendPQExpBuffer(&q, ",\n  am.amname AS \"%s\"", gettext_noop("Access method"));
+		appendPQExpBuffer(&q,
+						  ",\n  pg_catalog.pg_size_pretty(CASE WHEN dp.partmethod = 'h'"
+						  " THEN (SELECT pg_catalog.sum(sz.size) FROM sz JOIN pg_catalog.pg_dist_shard s ON s.shardid = sz.shard_id"
+						  " WHERE s.logicalrelid = c.oid)::pg_catalog.int8"
+						  " ELSE pg_catalog.pg_table_size(c.oid) END) AS \"%s\""
+						  ",\n  pg_catalog.obj_description(c.oid, 'pg_class') AS \"%s\"",
+						  gettext_noop("Size"),
+						  gettext_noop("Description"));
+	}
+	appendPQExpBuffer(&q,
+					  "%s\n     LEFT JOIN pg_catalog.pg_dist_partition dp ON dp.logicalrelid = c.oid%s"
+					  "ORDER BY 1, 2;",
+					  from, where);
+	res = PSQLexec(q.data);
+	termPQExpBuffer(&q);
+	if (!res)
+		return false;
+
+	/* 一张 Citus 表都没匹配上：交回原版输出 */
+	for (i = 0; i < PQntuples(res); i++)
+	{
+		const char *t = PQgetvalue(res, i, 2);
+
+		if (strcmp(t, "distributed_table") == 0)
+			any_citus = any_hash = true;
+		else if (strcmp(t, "reference_table") == 0)
+			any_citus = true;
+	}
+	if (!any_citus)
+	{
+		PQclear(res);
+		return false;
+	}
+	*rel_res = res;
+	if (!any_hash)
+		return true;
+
+	/* ---- List of shards：哈希分布表的全部分片 ---- */
+	initPQExpBuffer(&q);
+	if (verbose)
+		appendPQExpBuffer(&q,
+						  "WITH sz AS MATERIALIZED (SELECT shard_id, size FROM pg_catalog.citus_shard_sizes()),\n"
+						  "rc AS MATERIALIZED (SELECT r.shardid, r.success, r.result%s"
+						  "\n     JOIN pg_catalog.pg_dist_partition dp ON dp.logicalrelid = c.oid AND dp.partmethod = 'h'"
+						  "\n     CROSS JOIN LATERAL pg_catalog.run_command_on_shards(c.oid, 'SELECT count(*) FROM %%s') r"
+						  "%s)\n",
+						  from, where);
+	appendPQExpBuffer(&q,
+					  "SELECT n.nspname AS \"%s\", pg_catalog.shard_name(c.oid, s.shardid) AS \"%s\", c.relname AS \"%s\",\n"
+					  "  '[' || s.shardminvalue || ', ' || s.shardmaxvalue || ']' AS \"%s\",\n",
+					  gettext_noop("Schema"),
+					  gettext_noop("Name"),
+					  gettext_noop("Table"),
+					  gettext_noop("Hash range"));
+	shardpgAppendPrimaryReplicas(&q, have_partdist, "s.shardid");
+	if (verbose)
+		appendPQExpBuffer(&q,
+						  ",\n  (SELECT CASE WHEN rc.success THEN rc.result ELSE '?' END FROM rc WHERE rc.shardid = s.shardid) AS \"%s\""
+						  ",\n  pg_catalog.pg_size_pretty((SELECT sz.size FROM sz WHERE sz.shard_id = s.shardid)) AS \"%s\"",
+						  gettext_noop("Rows"),
+						  gettext_noop("Size"));
+	appendPQExpBuffer(&q,
+					  "%s"
+					  "\n     JOIN pg_catalog.pg_dist_partition dp ON dp.logicalrelid = c.oid AND dp.partmethod = 'h'"
+					  "\n     JOIN pg_catalog.pg_dist_shard s ON s.logicalrelid = c.oid%s"
+					  "ORDER BY n.nspname, c.relname, s.shardminvalue::pg_catalog.int4;",
+					  from, where);
+	*shard_res = PSQLexec(q.data);
+	termPQExpBuffer(&q);
+	return true;
+}
+
+/*
+ * ShardPG：\d / \d+ 的尾行附上分布信息 —— 照分区表 "Partition key" / "Number of partitions" 的写法：
+ *
+ *   Shard key: HASH (c_w_id)
+ *   Number of shards: 4 (Use \d+ to list them.)      ← \d；\d+ 换成逐个列出的 Shards:
+ *   Replicas per shard: 2                            ← 有 pg_partdist 主从登记时
+ *   Colocated with: orders                           ← 同一共置组的其他表
+ *
+ * 只对 Citus 哈希分布表生效；普通表、没装 Citus 时什么都不加。
+ */
+static void
+shardpgAddTableFooters(printTableContent *cont, const char *oid, bool verbose)
+{
+	PGresult   *res;
+	PQExpBufferData q;
+	PQExpBufferData line;
+	bool		have_partdist;
+	int			i;
+
+	if (!shardpgDetect(&have_partdist))
+		return;
+
+	initPQExpBuffer(&q);
+	appendPQExpBufferStr(&q,
+						 "SELECT pg_catalog.column_to_column_name(dp.logicalrelid, dp.partkey),\n"
+						 "  (SELECT pg_catalog.count(*) FROM pg_catalog.pg_dist_shard s WHERE s.logicalrelid = dp.logicalrelid),\n");
+	if (have_partdist)
+		appendPQExpBufferStr(&q,
+							 "  (SELECT pg_catalog.max(pg_catalog.cardinality(m.secondary_nodes)) FROM pg_catalog.pg_dist_shard s"
+							 " JOIN partdist.partition_map m ON m.partition_id = s.shardid WHERE s.logicalrelid = dp.logicalrelid),\n");
+	else
+		appendPQExpBufferStr(&q, "  NULL::pg_catalog.int4,\n");
+	appendPQExpBuffer(&q,
+					  "  (SELECT pg_catalog.string_agg(t.n, ', ' ORDER BY t.n)"
+					  " || CASE WHEN pg_catalog.max(t.total) > 10 THEN ' and ' || (pg_catalog.max(t.total) - 10) || ' more' ELSE '' END"
+					  " FROM (SELECT o.logicalrelid::pg_catalog.regclass::pg_catalog.text AS n, pg_catalog.count(*) OVER () AS total"
+					  " FROM pg_catalog.pg_dist_partition o WHERE o.colocationid = dp.colocationid AND dp.colocationid <> 0"
+					  " AND o.logicalrelid <> dp.logicalrelid ORDER BY 1 LIMIT 10) t)\n"
+					  "FROM pg_catalog.pg_dist_partition dp WHERE dp.logicalrelid = '%s' AND dp.partmethod = 'h';",
+					  oid);
+	res = PSQLexec(q.data);
+	if (!res || PQntuples(res) != 1)
+	{
+		PQclear(res);
+		termPQExpBuffer(&q);
+		return;
+	}
+
+	initPQExpBuffer(&line);
+	printfPQExpBuffer(&line, _("Shard key: HASH (%s)"), PQgetvalue(res, 0, 0));
+	printTableAddFooter(cont, line.data);
+	if (!verbose)
+	{
+		printfPQExpBuffer(&line, _("Number of shards: %s (Use \\d+ to list them.)"), PQgetvalue(res, 0, 1));
+		printTableAddFooter(cont, line.data);
+	}
+	if (!PQgetisnull(res, 0, 2))
+	{
+		printfPQExpBuffer(&line, _("Replicas per shard: %s"), PQgetvalue(res, 0, 2));
+		printTableAddFooter(cont, line.data);
+	}
+	if (!PQgetisnull(res, 0, 3))
+	{
+		printfPQExpBuffer(&line, _("Colocated with: %s"), PQgetvalue(res, 0, 3));
+		printTableAddFooter(cont, line.data);
+	}
+	PQclear(res);
+
+	if (verbose)
+	{
+		/* 逐个列出分片，照 \d+ 列分区的格式：续行缩进到第一项下面，项与项之间逗号 */
+		const char *ct = _("Shards");
+		int			ctw = pg_wcswidth(ct, strlen(ct), pset.encoding);
+		int			w0 = 0;
+		int			w1 = 0;
+
+		printfPQExpBuffer(&q,
+						  "SELECT pg_catalog.shard_name(s.logicalrelid, s.shardid),"
+						  " '[' || s.shardminvalue || ', ' || s.shardmaxvalue || ']',\n");
+		shardpgAppendPrimaryReplicas(&q, have_partdist, "s.shardid");
+		appendPQExpBuffer(&q,
+						  "\nFROM pg_catalog.pg_dist_shard s WHERE s.logicalrelid = '%s'"
+						  " ORDER BY s.shardminvalue::pg_catalog.int4;",
+						  oid);
+		res = PSQLexec(q.data);
+		if (res)
+		{
+			for (i = 0; i < PQntuples(res); i++)
+			{
+				w0 = Max(w0, (int) strlen(PQgetvalue(res, i, 0)));
+				w1 = Max(w1, (int) strlen(PQgetvalue(res, i, 1)));
+			}
+			if (PQntuples(res) == 0)
+			{
+				printfPQExpBuffer(&line, _("Number of shards: %d"), 0);
+				printTableAddFooter(cont, line.data);
+			}
+			for (i = 0; i < PQntuples(res); i++)
+			{
+				if (i == 0)
+					printfPQExpBuffer(&line, "%s: ", ct);
+				else
+					printfPQExpBuffer(&line, "%*s  ", ctw, "");
+				appendPQExpBuffer(&line, "%-*s %-*s  primary %s",
+								  w0, PQgetvalue(res, i, 0), w1, PQgetvalue(res, i, 1),
+								  PQgetisnull(res, i, 2) ? "?" : PQgetvalue(res, i, 2));
+				if (!PQgetisnull(res, i, 3))
+					appendPQExpBuffer(&line, ", replicas %s", PQgetvalue(res, i, 3));
+				if (i < PQntuples(res) - 1)
+					appendPQExpBufferChar(&line, ',');
+				printTableAddFooter(cont, line.data);
+			}
+			PQclear(res);
+		}
+	}
+	termPQExpBuffer(&line);
+	termPQExpBuffer(&q);
+}
+
+/*
+ * ShardPG：\dt 按名字找不到时，看它是不是某张分布式表的分片（子表）。
+ * 分片表只在 worker 上，master 的 pg_class 里没有，原版只会说"找不到"。
+ */
+static void
+shardpgHintShardName(const char *pattern)
+{
+	PQExpBufferData q;
+	PGresult   *res;
+
+	res = PSQLexec("SELECT pg_catalog.to_regclass('pg_catalog.pg_dist_shard') IS NOT NULL");
+	if (!res)
+		return;
+	if (PQntuples(res) != 1 || strcmp(PQgetvalue(res, 0, 0), "t") != 0)
+	{
+		PQclear(res);
+		return;
+	}
+	PQclear(res);
+
+	initPQExpBuffer(&q);
+	appendPQExpBufferStr(&q,
+						 "SELECT pg_catalog.shard_name(s.logicalrelid, s.shardid),"
+						 " s.logicalrelid::pg_catalog.regclass::pg_catalog.text\n"
+						 "FROM pg_catalog.pg_dist_shard s\n");
+	if (!validateSQLNamePattern(&q, pattern, false, false, NULL,
+								"pg_catalog.shard_name(s.logicalrelid, s.shardid)",
+								NULL, NULL, NULL, 1))
+	{
+		termPQExpBuffer(&q);
+		return;
+	}
+	appendPQExpBufferStr(&q, "ORDER BY 1 LIMIT 1;");
+	res = PSQLexec(q.data);
+	termPQExpBuffer(&q);
+	if (!res)
+		return;
+	if (PQntuples(res) == 1)
+		pg_log_error_hint("%s 是分布式表 %s 的分片（子表），用 \\dt %s 查看。",
+						  PQgetvalue(res, 0, 0), PQgetvalue(res, 0, 1),
+						  PQgetvalue(res, 0, 1));
+	PQclear(res);
+}

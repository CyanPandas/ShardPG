+/*
+ * patch 0017（诊断）：分片表 EPQ 顺更新链时以 TM_Deleted 放弃（行被当成已删除跳过）的现场。
+ * 每后端最多 40 条，只打分片表。
+ */
+static void
+shard_chain_diag(Relation relation, const char *why, HeapTuple tuple,
+				 TransactionId priorXmax)
+{
+	static int	n = 0;
+
+	if (n >= 40)
+		return;
+	n++;
+	if (tuple->t_data == NULL)
+		elog(LOG, "pg_partdist[diag] 顺链放弃(%s) rel=%u tid=(%u,%u) priorXmax=%u（槽位空：行指针非 NORMAL）",
+			 why, RelationGetRelid(relation),
+			 ItemPointerGetBlockNumber(&tuple->t_self), ItemPointerGetOffsetNumber(&tuple->t_self),
+			 priorXmax);
+	else
+		elog(LOG, "pg_partdist[diag] 顺链放弃(%s) rel=%u tid=(%u,%u) priorXmax=%u xmin=%u xmax=%u infomask=%04x infomask2=%04x ctid=(%u,%u)",
+			 why, RelationGetRelid(relation),
+			 ItemPointerGetBlockNumber(&tuple->t_self), ItemPointerGetOffsetNumber(&tuple->t_self),
+			 priorXmax,
+			 HeapTupleHeaderGetRawXmin(tuple->t_data), HeapTupleHeaderGetRawXmax(tuple->t_data),
+			 tuple->t_data->t_infomask, tuple->t_data->t_infomask2,
+			 ItemPointerGetBlockNumber(&tuple->t_data->t_ctid),
+			 ItemPointerGetOffsetNumber(&tuple->t_data->t_ctid));
+}

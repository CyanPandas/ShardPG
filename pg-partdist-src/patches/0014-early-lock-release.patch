+	/*
+	 * patch 0014：提前放锁。只换"何时刷"，不换"刷不刷"：下面走异步分支插入
+	 * 提交记录，CommitTransaction 末尾回复客户端前补 XLogFlush。删文件
+	 * （nrels）与 forceSyncCommit 照旧当场刷；并行 worker 不走。
+	 */
+	shard_elr_pending_lsn = InvalidXLogRecPtr;
+	if (shard_early_lock_release && !shard_elr_inhibit && wrote_xlog && markXidCommitted &&
+		synchronous_commit > SYNCHRONOUS_COMMIT_OFF &&
+		!forceSyncCommit && nrels == 0 && !IsParallelWorker())
+	{
+		XLogSetAsyncXactLSN(XactLastRecEnd);
+		TransactionIdAsyncCommitTree(xid, nchildren, children, XactLastRecEnd);
+		shard_elr_pending_lsn = XactLastRecEnd;
+	}
+	else if ((wrote_xlog && markXidCommitted &&
 		 synchronous_commit > SYNCHRONOUS_COMMIT_OFF) ||
 		forceSyncCommit || nrels > 0)
 	{
@@ -2430,6 +2450,21 @@
 	 */
 	s->state = TRANS_DEFAULT;
 
+	/*
+	 * patch 0014：提前放锁的提交在这里补刷 —— 锁、procarray 早已放掉，
+	 * 但回复客户端（CommandComplete / ReadyForQuery）在本函数返回之后。
+	 */
+	shard_elr_inhibit = false;
+	if (shard_elr_pending_lsn != InvalidXLogRecPtr)
+	{
+		XLogRecPtr	lsn = shard_elr_pending_lsn;
+
+		XLogFlush(lsn);
+		shard_elr_pending_lsn = InvalidXLogRecPtr;
+		if (shard_elr_post_flush_hook)
+			shard_elr_post_flush_hook();

+/*
+ * ShardPG：把表元素列表里的 SHARD KEY 子句（命名空间 "shardpg" 的 DefElem）挪进
+ * CREATE TABLE 的 options，选项逐个展开成 shardpg.column / shards / replicas / colocate。
+ * 外部表不支持（allowed = false）。
+ */
+static void
+extractShardClause(List **tableElts, List **options, bool allowed,
+				   core_yyscan_t yyscanner)
+{
+	ListCell   *lc;
+	List	   *keep = NIL;
+	bool		seen = false;
+
+	foreach(lc, *tableElts)
+	{
+		Node	   *elt = (Node *) lfirst(lc);
+		DefElem    *d;
+		ListCell   *lc2;
+
+		if (!IsA(elt, DefElem) ||
+			((DefElem *) elt)->defnamespace == NULL ||
+			strcmp(((DefElem *) elt)->defnamespace, "shardpg") != 0)
+		{
+			keep = lappend(keep, elt);
+			continue;
+		}
+		d = (DefElem *) elt;
+		if (!allowed)
+			ereport(ERROR,
+					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+					 errmsg("外部表不支持 SHARD KEY"),
+					 parser_errposition(d->location)));
+		if (seen)
+			ereport(ERROR,
+					(errcode(ERRCODE_SYNTAX_ERROR),
+					 errmsg("SHARD KEY 只能指定一次"),
+					 parser_errposition(d->location)));
+		seen = true;
+		foreach(lc2, (List *) d->arg)
+		{
+			DefElem    *o = lfirst_node(DefElem, lc2);
+			ListCell   *lc3;
+
+			foreach(lc3, *options)
+			{
+				DefElem    *prev = lfirst_node(DefElem, lc3);
+
+				if (prev->defnamespace != NULL &&
+					strcmp(prev->defnamespace, "shardpg") == 0 &&
+					strcmp(prev->defname, o->defname) == 0)
+					ereport(ERROR,
+							(errcode(ERRCODE_SYNTAX_ERROR),
+							 errmsg("SHARD KEY 选项 \"%s\" 重复", o->defname),
+							 parser_errposition(o->location)));
+			}
+			*options = lappend(*options, o);
+		}
+	}
+	*tableElts = keep;
+}

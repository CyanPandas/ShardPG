-- Wait for Demux Worker to route all 5 records to disk
SELECT partdist.demux_flush();
 demux_flush 
-------------
 
(1 row)

-- Should now be 5
SELECT partdist.count_parwal_records(9901::oid) = 5 AS five_records;

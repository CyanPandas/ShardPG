# 10 个 worker 的路线 A 实验室布局（2026-10-21，redeploy10w.sh / health10w_check.sh 共用，source 进来）
#   协调者 n1 144:31080；每个 worker 一主两备 ANY 1，备库放在另外两台机器上（同一个备库端口）
#   145：n2 31082 / n5 31101 / n8 31104 / n11 31107
#   147：n3 31081 / n6 31102 / n9 31105
#   148：n4 31083 / n7 31103 / n10 31106（148 的数据放 /data3）
#   备库端口：n2 31094 / n3 31095 / n4 31096（与 4 台机器部署相同），n5 .. n11 = 31111 .. 31117
# 数据目录与 4 台机器部署分开：主库 <根>/w10/data-nX，备库 <根>/shardpg-rep-w10/（REP_DIR），300 仓那套数据留在盘上不动。
KIT=tpcc-stdw10
export BASE148=/data3/yyt/shardpg-fix-20261014
export REP_DIR=shardpg-rep-w10
export EXTRA_WORKERS="n5:10.77.110.145:31101:shardpg-fix-n5:31111 n6:10.77.110.147:31102:shardpg-fix-n6:31112 n7:10.77.110.148:31103:shardpg-fix-n7:31113 n8:10.77.110.145:31104:shardpg-fix-n8:31114 n9:10.77.110.147:31105:shardpg-fix-n9:31115 n10:10.77.110.148:31106:shardpg-fix-n10:31116 n11:10.77.110.145:31107:shardpg-fix-n11:31117"
# 节点 id:主机:端口（协调者在第一个）
W10_NODES="1:10.77.110.144:31080 2:10.77.110.145:31082 3:10.77.110.147:31081 4:10.77.110.148:31083 5:10.77.110.145:31101 6:10.77.110.147:31102 7:10.77.110.148:31103 8:10.77.110.145:31104 9:10.77.110.147:31105 10:10.77.110.148:31106 11:10.77.110.145:31107"

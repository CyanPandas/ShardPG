# 云上三机 TPC-C：单副本 ShardPG（三机）对单机 PostgreSQL，标准规模。
# 复制成 cloud.env 再改；cloud/*.sh 都读这个文件。部署 / 压测脚本在客户端机 CLIENT_HOST 上执行，
# 镜像构建脚本（build_runtime_image.sh / build_citus_image.sh）在 A 上执行。

# 三台数据库机器的内网 IP。A = 协调者 + worker n2（+ 单机 PG），B、C 各一个 worker。
# 选哪台当 A：Citus 按"IP 字符串排序"轮流放分片（排序第 k 台拿第 k、k+3、… 号分片），各台分到的仓库数
# 随仓库数和分片数变：60 仓 / 12 分片时排在中间的那台分到 16 仓、另两台 21 / 23；100 仓 / 6 分片时
# 中间那台 28、另两台 34 / 38（按 Citus 的 hash 分段估算，deploy_*.sh 建完库会打印实际值）。
# 让 A 分到最少，给它上面的协调者腾 CPU。注意是字符串序：172.16.0.10 < 172.16.0.9。
A=172.16.0.11
B=172.16.0.12
C=172.16.0.13
# 压测客户端机（内网 IP，同一 VPC）。单独一台最好：数据库机器不必和客户端抢 CPU，三套受益相同。
# 不设就用 A（客户端容器跑在 A 上）。部署 / 压测脚本都在这台上执行。
CLIENT_HOST=172.16.0.14
HBA_CIDR=172.16.0.0/16      # 各库 trust 放行的网段（= VPC 网段）。安全组绝不能对公网开数据库端口
SSH_USER=root               # 客户端机免密 ssh 到 A/B/C、A 免密 ssh 到 B/C/客户端机的用户（要能直接跑 docker）
BASE=/data/sp               # 三台上的工作目录（放在数据盘上）：节点脚本、配置、数据目录都在这下面
PREFIX=sp                   # 本套件起的容器名前缀：sp-n1..n4、sp-native、sp-client

IMG=shardpg:prof            # ShardPG 镜像（从 lab 导出）；客户端容器也用它（psql / pgbench 16.14）
NATIVE_IMG=postgres:16.14   # 单机 PG 镜像（lab 的 postgres:16，即 16.14，install_images.sh 会打这个标签）；
                            # 用 build_runtime_image.sh 在云上现做时改成 sp-pgdg:16.14（不能冒用官方名字）
NATIVE_HOST=$A              # 单机 PG 放哪台（默认 A，和 ShardPG / Citus 的协调者同一台）

# 原版 Citus 对照（build_citus_image.sh / deploy_citus.sh）：以 NATIVE_IMG 为底编译 Citus 源码包
CITUS_IMG=sp-citus:13.1.0-pg16.14
# github.com/citusdata/citus/archive/refs/tags/v13.1.0.tar.gz 的 sha256（解开后与 lab Citus 对照用的源码逐文件相同）
CITUS_SHA256=2383287bea45dfce54cde9ffc98f3e27bb7cde4deb3f096f9c7a12d1819f5113

COORD_PORT=5432
# worker n2 / n3 / n4 依次用 WORKER_PORT、+1、+2（5433 / 5434 / 5435）。三台 worker 端口必须互不相同：
# 建分片组的 partdist.raft_replicate_table_shards[_bulk] 只按端口号认 worker，同端口时全部分片
# 会被当成第一台的、选主永远等不到（lab 冒烟测试实测卡死在"0/6 个分片由 placement 当选"）。
WORKER_PORT=5433
NATIVE_PORT=5432            # 与协调者同端口没关系：两套不会同时跑（bench.sh 会检查）

# 规模：要"单机装不下、三机装得下"。100 仓装载后 12 GB、压测中还涨，8 GB 机器三机也装不下（2026-10-18 实测）；
# 60 仓装载约 7 GB，三机每台 2–3 GB。
WAREHOUSES=60
SHARD_COUNT=12              # 每张表 12 个分片 = 每台 worker 4 个（60 仓时 6 分片会把最多的 23 仓分给 A）
LOAD_PARALLEL=4             # 装载并行度（= 核数）
MAX_TRIES=20                # pgbench 对 40001 / 40P01 的重试上限

TERMINAL_LIST="32 64 128"       # 每个终端数各跑 REPEAT 轮；终端多时协调者连接多、内存紧，留意 OOM
REPEAT=1
# 时长单位秒；pgbench 的 -T 要是 --aggregate-interval=60 的整数倍：WARMUP_S、RAMPUP_S + DURATION_S 都得是 60 的倍数
WARMUP_S=300                # 正式轮之前热身一轮（不计成绩；0 = 不热身）
RAMPUP_S=60                 # 每轮预热（不计成绩）
DURATION_S=300              # 每轮测量窗口

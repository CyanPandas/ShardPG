# TPC-C 集群拓扑（复制成 cluster.env 再改）。所有脚本都 source 这个文件。
#
# 三台服务器：A 上跑 coordinator（兼 TSO）+ worker1，B、C 各跑一个 worker。
# 每个分片的 Raft 组 = 1 主 + 2 副本，三台各一份。
# 主机名用 IP 或真实可解析的名字；**不要**用 coordinator / master / worker1..3 ——
# 若一定要用，必须在每个节点设 pg_raft.loopback_node_names = off（见 conf/node.conf.tmpl）。

# node_id 从 1 起，1 号必须是 coordinator
NODE_IDS=(1 2 3 4)
NODE_HOSTS=(10.0.0.1 10.0.0.1 10.0.0.2 10.0.0.3)
NODE_PORTS=(5432 5433 5433 5433)
NODE_ROLES=(coordinator worker worker worker)

COORD_HOST=10.0.0.1
COORD_PORT=5432

# 每台服务器上 PostgreSQL 的安装目录与数据目录（gen_node_conf.sh / 运维命令用）
PG_BIN=/opt/shardpg/pg-install/bin
PGDATA_ROOT=/data/shardpg

# 压测规模
WAREHOUSES=10
TERMINALS=16
DURATION_S=21600          # 6 h 测量窗口
RAMPUP_S=900              # 15 min 预热，不计入成绩
SHARD_COUNT=6             # 每张表的分片数（= 每台服务器 2 个主分片）
REPLICAS=2                # 每个分片的副本数（Raft 组 = 1 + REPLICAS）
LOAD_PARALLEL=3           # 装载并行度
MAX_TRIES=20              # pgbench 对 40001 / 40P01 的最大重试次数

# 结果目录（每次运行一个子目录）
RESULT_ROOT=./results
